# ==============================================================================
# Security Headers
# ==============================================================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header unset X-Powered-By
</IfModule>

# Ensure directory requests find index.html and index.php
DirectoryIndex index.html index.php

# ==============================================================================
# SPA Routing & Rewrites (Works in root domain and any sub-directory / base URL)
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Mailer API: Route ANY request containing api/send-email directly to the PHP script
  RewriteRule (^|.*/)api/send-email/?$ api/send-email/index.php [L,QSA]
  RewriteRule (^|.*/)api/send-email\.php$ api/send-email/index.php [L,QSA]
  RewriteRule (^|.*/)api/send-email/index\.php$ api/send-email/index.php [L,QSA]

  # 2. Allow existing physical files and directories to pass through directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Sub-app SPA routing (handles client-side routes like /products/esmart-restaurant/about)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^products/esmart-restaurant(/.*)?$ products/esmart-restaurant/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^products/esmart-school(/.*)?$ products/esmart-school/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^products/emart-queue(/.*)?$ products/emart-queue/index.html [L]

  # 4. Main React App SPA routing — redirect all virtual paths (/careers, /admin, /contact, etc.) to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^.*$ index.html [L]
</IfModule>

# Fallback for servers where mod_rewrite is not permitted
ErrorDocument 404 index.html
